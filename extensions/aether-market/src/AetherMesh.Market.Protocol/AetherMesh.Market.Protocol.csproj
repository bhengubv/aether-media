<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>AetherMesh.Market.Protocol</PackageId>
    <Description>Wire protocol and packet definitions for Aether Market — PoV tokens, market listings, and trade escrow packets for the Aether mesh network.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherMesh.Market.Core/AetherMesh.Market.Core.csproj" />
    <ProjectReference Include="../../../../src/AetherMesh.Media.DependencyInjection/AetherMesh.Media.DependencyInjection.csproj" />
    <!-- Market requires Space (geo-pinned listings) and Vault (document escrow) -->
    <ProjectReference Include="../../../aether-space/src/AetherMesh.Space.Protocol/AetherMesh.Space.Protocol.csproj" />
    <ProjectReference Include="../../../aether-vault/src/AetherMesh.Vault.ErasureCoding/AetherMesh.Vault.ErasureCoding.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../../../aether-protocol/src/AetherMesh.Core/AetherMesh.Core.csproj')">
    <ProjectReference Include="../../../../../aether-protocol/src/AetherMesh.Core/AetherMesh.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../../../aether-protocol/src/AetherMesh.Core/AetherMesh.Core.csproj')">
    <PackageReference Include="AetherMesh.Core" Version="1.1.0" />
  </ItemGroup>

</Project>
