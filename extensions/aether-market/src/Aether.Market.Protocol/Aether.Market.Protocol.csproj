<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Aether.Market.Protocol</PackageId>
    <Description>Wire protocol and packet definitions for Aether Market — PoV tokens, market listings, and trade escrow packets for the Aether mesh network.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aether.Market.Core/Aether.Market.Core.csproj" />
    <ProjectReference Include="../../../../src/Aether.Media.DependencyInjection/Aether.Media.DependencyInjection.csproj" />
    <!-- Market requires Space (geo-pinned listings) and Vault (document escrow) -->
