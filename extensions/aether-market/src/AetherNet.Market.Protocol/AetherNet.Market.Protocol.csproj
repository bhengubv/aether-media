<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>AetherNet.Market.Protocol</PackageId>
    <Description>Wire protocol and packet definitions for Aether Market — PoV tokens, market listings, and trade escrow packets for the Aether mesh network.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNet.Market.Core/AetherNet.Market.Core.csproj" />
    <ProjectReference Include="../../../../src/AetherNet.Media.DependencyInjection/AetherNet.Media.DependencyInjection.csproj" />
    <!-- Market requires Space (geo-pinned listings) and Vault (document escrow) -->
    <ProjectReference Include="../../../aether-space/src/AetherNet.Space.Protocol/AetherNet.Space.Protocol.csproj" />
    <ProjectReference Include="../../../aether-vault/src/AetherNet.Vault.ErasureCoding/AetherNet.Vault.ErasureCoding.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj')">
    <ProjectReference Include="../../../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj')">
    <PackageReference Include="AetherNet.Core" Version="1.1.0" />
  </ItemGroup>

</Project>
