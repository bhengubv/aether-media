<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>AetherMedia.LocalLibrary</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>
      Privacy-first local media management for Aether Media — metadata editing,
      manual and smart collections, and subtitle discovery via OpenSubtitles.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherMedia.Core\AetherMedia.Core.csproj" />
    <InternalsVisibleTo Include="AetherMedia.LocalLibrary.Tests" />
  </ItemGroup>

  <!-- AetherNet protocol — local source if available, NuGet fallback. Same
       conditional shape as AetherMedia.Content / .Streaming / .Social. -->
  <ItemGroup Condition="Exists('../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj')">
    <ProjectReference Include="../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj" />
    <ProjectReference Include="../../../aether-protocol/src/AetherNet.Content/AetherNet.Content.csproj" />
    <ProjectReference Include="../../../aether-protocol/src/AetherNet.Streaming/AetherNet.Streaming.csproj" />
    <ProjectReference Include="../../../aether-protocol/src/AetherNet.Messaging/AetherNet.Messaging.csproj" />
    <ProjectReference Include="../../../aether-protocol/src/AetherNet.Forge/AetherNet.Forge.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj')">
    <PackageReference Include="AetherNet.Core"      Version="1.5.0" />
    <PackageReference Include="AetherNet.Content"   Version="1.5.0" />
    <PackageReference Include="AetherNet.Streaming" Version="1.5.0" />
    <PackageReference Include="AetherNet.Messaging" Version="1.5.0" />
    <PackageReference Include="AetherNet.Forge"     Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same version as AetherMedia.Content — no duplication in restore graph -->
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
