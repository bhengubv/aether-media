<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>AetherMedia.LocalLibrary</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>
      Privacy-first local media management for Aether Media — metadata editing,
      manual and smart collections, and subtitle discovery via OpenSubtitles.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherMedia.Core\AetherMedia.Core.csproj" />
    <InternalsVisibleTo Include="AetherMedia.LocalLibrary.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same version as AetherMedia.Content — no duplication in restore graph -->
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
