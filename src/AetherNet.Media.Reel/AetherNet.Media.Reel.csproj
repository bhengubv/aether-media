<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>AetherNet.Media.Reel</PackageId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>
      Decentralised short-video (Reel) platform for Aether Media — on-device For You
      algorithm, mesh-gossipped trending, duet/stitch, sound library, and engagement
      tracking that never leaves the device.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherNet.Media.Core\AetherNet.Media.Core.csproj" />
    <ProjectReference Include="..\AetherNet.Media.Content\AetherNet.Media.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
