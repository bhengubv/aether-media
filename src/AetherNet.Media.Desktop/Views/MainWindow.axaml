<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AetherNet.Media.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="AetherNet.Media.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Aether Media"
        Background="#1a1a2e"
        MinWidth="800"
        MinHeight="500">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,30">

        <!-- ── Main area: left nav + right content ── -->
        <Grid Grid.Row="0" ColumnDefinitions="100,*">

            <!-- Left navigation pane (100 px wide) -->
            <Border Grid.Column="0"
                    Background="#12121f"
                    BorderBrush="#222238"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">

                    <!-- Home nav item -->
                    <Grid>
                        <Button Command="{Binding NavigateHomeCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,14"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="🏠"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Home"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#888"/>
                            </StackPanel>
                        </Button>
                        <!-- Active indicator: left blue bar -->
                        <Border Width="3"
                                Background="#2196F3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding IsHomeSelected}"/>
                    </Grid>

                    <!-- Nearby nav item -->
                    <Grid>
                        <Button Command="{Binding NavigateNearbyCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,14"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="📡"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Nearby"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#888"/>
                            </StackPanel>
                        </Button>
                        <Border Width="3"
                                Background="#2196F3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding IsNearbySelected}"/>
                    </Grid>

                    <!-- Library nav item -->
                    <Grid>
                        <Button Command="{Binding NavigateLibraryCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,14"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="📚"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Library"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#888"/>
                            </StackPanel>
                        </Button>
                        <Border Width="3"
                                Background="#2196F3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding IsLibrarySelected}"/>
                    </Grid>

                    <!-- Watch Together nav item -->
                    <Grid>
                        <Button Command="{Binding NavigatePlayerCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,14"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="👥"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Watch"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#888"/>
                            </StackPanel>
                        </Button>
                        <Border Width="3"
                                Background="#2196F3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding IsPlayerVisible}"/>
                    </Grid>

                    <!-- Profile nav item -->
                    <Grid>
                        <Button Command="{Binding NavigateProfileCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,14"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="👤"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Profile"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#888"/>
                            </StackPanel>
                        </Button>
                        <Border Width="3"
                                Background="#2196F3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding IsProfileVisible}"/>
                    </Grid>

                    <!-- More Apps nav item -->
                    <Grid>
                        <Button Command="{Binding NavigateMoreAppsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,14"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="📲"
                                           FontSize="20"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Get Apps"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#888"/>
                            </StackPanel>
                        </Button>
                        <Border Width="3"
                                Background="#2196F3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding IsMoreAppsSelected}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Right content area: ViewLocator resolves CurrentViewModel to the matching view -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}"
                            Background="#1a1a2e"/>

        </Grid>

        <!-- Bottom mesh status bar (30 px) -->
        <Border Grid.Row="1"
                Background="#0d0d1a"
                BorderBrush="#222238"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Transport indicator -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="#4dff91"/>
                    <TextBlock Text="Aether Mesh"
                               Foreground="#888"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Transport name -->
                <TextBlock Grid.Column="1"
                           Text="Local transport active"
                           Foreground="#444"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Peer count + bandwidth -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="#555" FontSize="11">
                        <Run Text="Peers: "/>
                        <Run Text="0"/>
                    </TextBlock>
                    <TextBlock Foreground="#444" FontSize="11" Text="·"/>
                    <TextBlock Foreground="#555" FontSize="11">
                        <Run Text="0 KB/s"/>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>

</Window>
