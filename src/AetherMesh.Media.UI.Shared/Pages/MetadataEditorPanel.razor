@using AetherMesh.Media.UI.Shared.ViewModels

<div class="am-meta-editor">
    <div class="am-tabs">
        <span class="am-tab @(Editor.IsAudioMode ? "am-tab-active" : "")">Audio</span>
        <span class="am-tab @(Editor.IsVideoMode ? "am-tab-active" : "")">Video</span>
    </div>

    @if (!string.IsNullOrEmpty(Editor.StatusMessage))
    {
        <p class="am-status-message">@Editor.StatusMessage</p>
    }

    <div class="am-form">
        <label class="am-label">Title</label>
        <input class="am-input" value="@Editor.Title"
               @oninput="e => Editor.Title = e.Value?.ToString() ?? string.Empty" />

        @if (Editor.IsAudioMode)
        {
            <label class="am-label">Artist</label>
            <input class="am-input" value="@Editor.Artist"
                   @oninput="e => Editor.Artist = e.Value?.ToString() ?? string.Empty" />

            <label class="am-label">Album</label>
            <input class="am-input" value="@Editor.Album"
                   @oninput="e => Editor.Album = e.Value?.ToString() ?? string.Empty" />

            <label class="am-label">Year</label>
            <input class="am-input" type="number" value="@Editor.Year"
                   @oninput="e => { if (uint.TryParse(e.Value?.ToString(), out var y)) Editor.Year = y; }" />

            <label class="am-label">Genres (comma separated)</label>
            <input class="am-input" value="@Editor.GenresText"
                   @oninput="e => Editor.GenresText = e.Value?.ToString() ?? string.Empty" />
        }
        else
        {
            <label class="am-label">Plot</label>
            <textarea class="am-input am-textarea" value="@Editor.Plot"
                      @oninput="e => Editor.Plot = e.Value?.ToString() ?? string.Empty"></textarea>

            <label class="am-label">IMDb ID</label>
            <input class="am-input" value="@Editor.ImdbId"
                   @oninput="e => Editor.ImdbId = e.Value?.ToString() ?? string.Empty" />

            <label class="am-label">Rating</label>
            <input class="am-input" type="number" step="0.1" value="@Editor.Rating"
                   @oninput="e => { if (float.TryParse(e.Value?.ToString(), out var r)) Editor.Rating = r; }" />
        }
    </div>

    <button class="am-btn am-btn-primary"
            @onclick="() => Editor.SaveCommand.Execute(null)"
            disabled="@Editor.IsSaving">
        @(Editor.IsSaving ? "Saving…" : "💾 Save")
    </button>
</div>

@code {
    [Parameter, EditorRequired] public MetadataEditorViewModel Editor { get; set; } = null!;
}
