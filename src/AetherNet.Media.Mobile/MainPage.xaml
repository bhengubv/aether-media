<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AetherNet.Media.Mobile"
             x:Class="AetherNet.Media.Mobile.MainPage"
             BackgroundColor="#0d0d1a">

    <!--
        RootComponents are wired in code-behind (MainPage.xaml.cs) so that
        XamlC does not try to resolve the Razor-generated Routes type before
        the Blazor source-generator has produced it.
    -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" />

</ContentPage>
