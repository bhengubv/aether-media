<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.Media.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Aether.Media.Desktop.Views.MoreAppsView"
             x:DataType="vm:MoreAppsViewModel"
             Background="#1a1a2e">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,20">

        <!-- ── Header ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Install From a Friend"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"/>
            <TextBlock Text="Share any app in the ecosystem — no app store needed."
                       FontSize="13"
                       Foreground="#888"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ── Share This App panel ── -->
        <Border Grid.Row="1"
                Background="#12121f"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,20"
                BorderBrush="#2196F3"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Left: share controls -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="Share Aether Media"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Download the latest Android APK and host it locally. Anyone nearby can scan the QR with their camera — no internet, no app store."
                               FontSize="12"
                               Foreground="#888"
                               TextWrapping="Wrap"
                               MaxWidth="480"/>

                    <!-- Progress bar (visible while downloading) -->
                    <ProgressBar Value="{Binding DownloadProgress}"
                                 Minimum="0" Maximum="1"
                                 Height="4"
                                 Foreground="#2196F3"
                                 Background="#222238"
                                 CornerRadius="2"
                                 IsVisible="{Binding IsDownloading}"/>

                    <!-- Bootstrap URL (visible while hosting) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding IsHosting}">
                        <TextBlock Text="{Binding BootstrapUrl}"
                                   FontSize="12"
                                   Foreground="#4dff91"
                                   FontFamily="Courier New"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Share This App"
                                Command="{Binding ShareThisApp}"
                                IsEnabled="{Binding IsNotHosting}"
                                Background="#2196F3"
                                Foreground="White"
                                Padding="16,8"
                                CornerRadius="6"
                                FontSize="13"/>
                        <Button Content="Stop Sharing"
                                Command="{Binding StopSharing}"
                                IsVisible="{Binding IsHosting}"
                                Background="#333"
                                Foreground="#ccc"
                                Padding="16,8"
                                CornerRadius="6"
                                FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: QR code -->
                <Border Grid.Column="1"
                        IsVisible="{Binding IsHosting}"
                        Background="White"
                        CornerRadius="6"
                        Padding="8"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                    <Image Source="{Binding QrCodeBitmap}"
                           Width="140"
                           Height="140"
                           RenderOptions.BitmapInterpolationMode="None"/>
                </Border>

            </Grid>
        </Border>

        <!-- ── Ecosystem app list ── -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppPackageViewModel">
                        <Border Background="#12121f"
                                CornerRadius="8"
                                Padding="16,14"
                                Margin="0,0,12,12"
                                Width="280"
                                BorderBrush="#222238"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                                <!-- App name -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>

                                <!-- Tags -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding TagsDisplay}"
                                           FontSize="11"
                                           Foreground="#2196F3"
                                           Margin="0,3,0,0"/>

                                <!-- Description -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#888"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,12"/>

                                <!-- Ready indicator -->
                                <TextBlock Grid.Row="3"
                                           Text="Downloaded — open the file to install"
                                           FontSize="11"
                                           Foreground="#4dff91"
                                           IsVisible="{Binding IsReady}"
                                           Margin="0,0,0,8"/>

                                <!-- Get button -->
                                <Button Grid.Row="4"
                                        Content="Get"
                                        Command="{Binding $parent[ItemsControl].((vm:MoreAppsViewModel)DataContext).GetAppCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding !IsReady}"
                                        HorizontalAlignment="Right"
                                        Background="#1c2f4a"
                                        Foreground="#2196F3"
                                        Padding="20,6"
                                        CornerRadius="5"
                                        FontSize="12"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Status bar ── -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="#666"
                   Margin="0,12,0,0"/>

    </Grid>
</UserControl>
