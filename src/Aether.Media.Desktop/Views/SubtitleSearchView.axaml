<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aether.Media.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Aether.Media.Desktop.Views.SubtitleSearchView"
             x:DataType="vm:SubtitleSearchViewModel"
             x:CompileBindings="False"
             Background="#13132a">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="16,12,16,8">
            <TextBlock DockPanel.Dock="Left"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Text="🗒  Subtitles"/>

            <!-- Language selector -->
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center">
                <TextBlock Text="Language:"
                           Foreground="#888" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBox Text="{Binding LanguageCode}"
                         Width="44"
                         Background="#1e1e38" Foreground="White"
                         BorderBrush="#333" BorderThickness="1" CornerRadius="6"
                         Padding="6,4" FontSize="12"
                         MaxLength="5"/>
                <Button Command="{Binding SearchCommand}"
                        IsEnabled="{Binding !IsSearching}"
                        Content="Search"
                        Background="#2c3e50" Foreground="White"
                        Padding="10,5" CornerRadius="6" FontSize="12"/>
            </StackPanel>
        </DockPanel>

        <!-- Results list -->
        <Grid Grid.Row="1">

            <!-- Searching spinner -->
            <StackPanel IsVisible="{Binding IsSearching}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <ProgressBar IsIndeterminate="True"
                             Width="120" Height="3"
                             Foreground="#2196F3"
                             Background="Transparent"/>
                <TextBlock Text="Searching OpenSubtitles…"
                           Foreground="#888" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Empty state — shown when not searching and list is empty -->
            <TextBlock IsVisible="{Binding HasNoResults}"
                       Text="{Binding StatusMessage}"
                       Foreground="#555"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- Results — ListBox for selection support -->
            <ListBox IsVisible="{Binding !IsSearching}"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="16,0,16,4"
                     Padding="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding"      Value="0"/>
                        <Setter Property="Background"   Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2196F330"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubtitleSearchResultViewModel">
                        <Border Margin="0,3"
                                Padding="10,8"
                                CornerRadius="8"
                                Background="#1e1e38"
                                Cursor="Hand">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="#272744"/>
                                </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding ReleaseName}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Language}"
                                                   Foreground="#2196F3"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BadgeText}"
                                                   Foreground="#888"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RatingText}"
                                                   Foreground="#f0c040"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Hash-match indicator -->
                                <Border Grid.Column="1"
                                        IsVisible="{Binding HashMatch}"
                                        Background="#1a4a1a"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="✓ exact"
                                               Foreground="#4caf50"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Footer: selected + download -->
        <DockPanel Grid.Row="2" Margin="16,0,16,12">
            <Button DockPanel.Dock="Right"
                    Command="{Binding DownloadCommand}"
                    IsEnabled="{Binding CanDownload}"
                    IsVisible="{Binding SelectedResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Content="⬇  Download"
                    Background="#2196F3"
                    Foreground="White"
                    Padding="14,7"
                    CornerRadius="6"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#2196F3"
                       FontSize="12"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"
                       IsVisible="{Binding !IsSearching}"/>
        </DockPanel>

    </Grid>

</UserControl>
