<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>AetherMesh.Media.Distribution</PackageId>
    <Description>
      Mesh-first app distribution for Aether Media — share the app like a file,
      update from Cloudflare, discover the full ecosystem from a single install.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherMesh.Media.Core\AetherMesh.Media.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../aether-protocol/src/AetherMesh.Core/AetherMesh.Core.csproj')">
    <ProjectReference Include="../../../aether-protocol/src/AetherMesh.Core/AetherMesh.Core.csproj" />
    <ProjectReference Include="../../../aether-protocol/src/AetherMesh.Content/AetherMesh.Content.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../aether-protocol/src/AetherMesh.Core/AetherMesh.Core.csproj')">
    <PackageReference Include="AetherMesh.Core"    Version="1.1.0" />
    <PackageReference Include="AetherMesh.Content" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
