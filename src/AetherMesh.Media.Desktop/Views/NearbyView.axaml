<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AetherMesh.Media.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AetherMesh.Media.Desktop.Views.NearbyView"
             x:DataType="vm:NearbyViewModel"
             Background="Transparent">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="20,16,20,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Nearby"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Border Background="#2196F3"
                        CornerRadius="10"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsScanning}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="#4dff91"/>
                        <TextBlock Text="Scanning"
                                   Foreground="White"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Foreground="#888" FontSize="12">
                    <Run Text="{Binding PeerCount}"/>
                    <Run Text=" peers"/>
                </TextBlock>
                <Button Command="{Binding StartScanCommand}"
                        Content="Scan"
                        Background="#2196F3"
                        Foreground="White"
                        Padding="12,6"
                        CornerRadius="6"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="0">

                <!-- Active streams section -->
                <StackPanel IsVisible="{Binding ActiveStreams.Count}" Margin="0,4,0,0">
                    <TextBlock Text="ACTIVE STREAMS"
                               Margin="20,0,20,8"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#2196F3"
                               LetterSpacing="2"/>
                    <ItemsControl ItemsSource="{Binding ActiveStreams}" Margin="16,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LiveStreamViewModel">
                                <Border Margin="0,4"
                                        CornerRadius="10"
                                        Background="#1e1e38"
                                        Padding="16,12"
                                        Cursor="Hand">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#272744"/>
                                        </Style>
                                    </Border.Styles>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="#e53935"
                                                        CornerRadius="3"
                                                        Padding="4,2">
                                                    <TextBlock Text="● LIVE"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Foreground="#888" FontSize="12">
                                                <Run Text="{Binding CreatorUhid}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Codec}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Spacing="2">
                                            <TextBlock Foreground="#aaa" FontSize="13" HorizontalAlignment="Right">
                                                <Run Text="{Binding ViewerCount}"/>
                                                <Run Text=" 👁"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ElapsedFormatted}"
                                                       Foreground="#555"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Nearby creators -->
                <TextBlock Text="NEARBY CREATORS"
                           Margin="20,16,20,8"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#888"
                           LetterSpacing="2"/>

                <StackPanel IsVisible="{Binding !NearbyCreators.Count}"
                            Margin="20,8"
                            Spacing="4">
                    <TextBlock Text="No creators discovered yet"
                               Foreground="#555"
                               FontSize="14"/>
                    <TextBlock Text="Tap Scan to start looking for mesh peers"
                               Foreground="#444"
                               FontSize="12"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NearbyCreators}" Margin="16,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MediaProfileViewModel">
                            <Border Margin="0,4"
                                    CornerRadius="10"
                                    Background="#1e1e38"
                                    Padding="16,12"
                                    Cursor="Hand">
                                <Border.Styles>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background" Value="#272744"/>
                                    </Style>
                                </Border.Styles>
                                <Grid ColumnDefinitions="44,*,Auto">
                                    <!-- Avatar placeholder -->
                                    <Border Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            Background="#2c2c50"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="👤"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="18"/>
                                    </Border>
                                    <!-- Info -->
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock IsVisible="{Binding IsVerified}"
                                                       Text="✓"
                                                       Foreground="#2196F3"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AetherMeshTagValue}"
                                                   Foreground="#888"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <!-- Stats -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Foreground="#aaa" FontSize="12" HorizontalAlignment="Right">
                                            <Run Text="{Binding FollowerCount}"/>
                                            <Run Text=" followers"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#555" FontSize="11" HorizontalAlignment="Right">
                                            <Run Text="{Binding ContentCount}"/>
                                            <Run Text=" posts"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
