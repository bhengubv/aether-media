<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>
      Round-trip relay test for Aether Media: creates two HttpRelayTransportService
      nodes, sends a MediaContent descriptor from node A to node B, and prints latency.
      Start samples/AetherNet.RelayServer from aether-protocol on port 5200 first.
    </Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="Exists('../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj')">
    <ProjectReference Include="../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj" />
    <ProjectReference Include="../../../aether-protocol/src/AetherNet.Transport/AetherNet.Transport.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../aether-protocol/src/AetherNet.Core/AetherNet.Core.csproj')">
    <PackageReference Include="AetherNet.Core"      Version="2.4.1" />
    <PackageReference Include="AetherNet.Transport" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
