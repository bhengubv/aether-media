<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>
      Interactive console demo for Aether Media showing all five subsystems:
      Identity, Content, Social, Streaming, and AI — running fully offline.
    </Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aether.Media.DependencyInjection\Aether.Media.DependencyInjection.csproj" />
  </ItemGroup>

  <!-- Aether.Core provides IDtnService, IMeshSender, DtnBundle, MeshPacket, PeerInfo -->
  <ItemGroup Condition="Exists('../../../aether-protocol/src/Aether.Core/Aether.Core.csproj')">
    <ProjectReference Include="../../../aether-protocol/src/Aether.Core/Aether.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../aether-protocol/src/Aether.Core/Aether.Core.csproj')">
    <PackageReference Include="AetherMesh.Core" Version="1.0.3" />
  </ItemGroup>

  <!-- Aether.DependencyInjection provides AddAetherProtocol() + the in-memory offline service stack -->
  <ItemGroup Condition="Exists('../../../aether-protocol/src/Aether.DependencyInjection/Aether.DependencyInjection.csproj')">
    <ProjectReference Include="../../../aether-protocol/src/Aether.DependencyInjection/Aether.DependencyInjection.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../aether-protocol/src/Aether.DependencyInjection/Aether.DependencyInjection.csproj')">
    <PackageReference Include="AetherMesh.DependencyInjection" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting"             Version="10.0.0" />
  </ItemGroup>

</Project>
