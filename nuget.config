<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local AetherNet 2.0.0 feed: the sibling aether-protocol repo's `dotnet pack`
         output (path relative to this repo root; aether-protocol sits beside it).
         Lets AetherMedia resolve the AetherNet.* packages from the freshly-packed
         artifact. nuget.org stays as the upstream fallback for everything else and
         for AetherNet once a version is indexed there. -->
    <add key="aethernet-local" value="..\aether-protocol\artifacts\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
